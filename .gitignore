# NovelMaestro: в git не попадают личные настройки, рантайм-данные и артефакты
# инструментов. .gitignore не трогает уже отслеживаемые файлы: TODO.md игнорируется
# как содержимое сборок, но сам файл в git остаётся намеренно.

# Python: байт-код
__pycache__/
*.py[cod]
*$py.class

# Артефакты разработки: кэш pytest (.tmp/pytest, см. pytest.ini) и данные
# покрытия (.tmp/coverage, см. dev.sh cmd_cov), кэш ruff и виртуальные окружения
.tmp/
.ruff_cache/
.venv/
venv/
env/

# Личные настройки инструментов и редакторов
pyrightconfig.json
.vscode/
.idea/
*.iml
.DS_Store
.pylintrc

# Данные: книги, картинки, архив удалённых .env книг (содержат ключи)
projects/
Images/
backup/

# Рантайм-веб: логи (в том числе скриншоты UI-прогона), очередь запусков и её логи
logs/
web/jobs.json
web/job_logs/

# Локальный конфиг с ключами, профили LLM (тоже ключи) и вывод локальных сборок
.env
/llm_profiles.json
dist/

# Персональные наборы шаблонов
/templates/Custom

# Внутренний план разработки: в сборки (Docker/Windows) не попадает, в git остаётся
TODO.md
