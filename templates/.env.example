# NovelMaestro — пример общего конфигурационного файла.
#
# ФАЙЛ ОДИН на все книги: своего .env у проекта больше нет. Скопируйте
# этот файл в корень репозитория как .env (в Docker — projects/.env, путь
# задаётся WEB_ENV_FILE), оставив только то, что отличается от вшитых
# значений. Приоритет: CLI-флаг > переменные окружения процесса > этот
# файл > встроенный дефолт реестра core/settings.py.
#
# Файл машиночитаемый: страница «Настройки» перезаписывает его целиком
# (ключи идут в порядке реестра, пустые значения снимаются), поэтому
# комментарии здесь only-read — после первого сохранения они исчезнут.
#
# LLM-настройки здесь — значения встроенного профиля General. Профиль —
# полный набор настроек работы с моделью (сервер, ключ, модель, потоки,
# таймауты, ретраи, рассуждения); их может быть несколько, а в запусках
# проекта выбирается один. Дополнительные профили живут в соседнем файле
# llm_profiles.json и хранят только свои переопределения: пустое поле
# профиля наследует General. Создаются и правятся профили на странице
# «Настройки»; выбор профиля по проекту остаётся в браузере (localStorage).
#
# Синтаксис: KEY=VALUE; «export » терпим; парные кавычки снимаются; «#»
# вне кавычек начинает комментарий — значение с решёткой пишется в
# кавычках ("a # b"); ${VAR} не раскрывается. Пустое значение = пустая
# строка, оно не затеняет ключ. Секреты (API_KEY, WEB_TOKEN) в интерфейс
# не выезжают: поле показывается маской (точка на символ значения), и если его
# не меняли, значение в файле остаётся прежним.

# ══ Модель и сервер ══════════════

# ── Подключение (llm_conn) ──
# Сервер LLM
# адрес API-сервера; /v1 дописывается, если его нет
HOST=https://routerai.ru/api/v1
# API-ключ
# локальный сервер может работать без ключа
# секрет: в UI показывается маской
API_KEY=
# Модель
# одна модель на весь конвейер: отдельных моделей у стадий больше нет
MODEL=google/gemma-4-31b-it

# ── Сеть и повторы (llm_net) ──
# Таймаут запроса, СЕК
TIMEOUT=300
# Таймаут стрима, СЕК
# пауза между строками SSE
STREAM_TIMEOUT=300
# Попыток запроса к LLM
# всего попыток, включая первую (0 и 1 — без повторов); повтор — на 408/425/429/5xx, обрыв потока, таймаут и пустой ответ; прочие 4xx (400/401/403/404) — сразу ошибка
MAX_RETRIES=3
# Предел ответа, ТОКЕНЫ
# max_tokens в payload (не расчёт)
MAX_TOKENS=65536

# ── Температура и параллельность (llm_run) ──
# Температура (пусто = сервер)
TEMPERATURE=
# Потоков (1–16)
# одна величина на весь конвейер
THREADS=4

# ── Рассуждения модели (llm_reasoning) ──
# Рассуждения
# для openai-профиля рассуждения включаются только ключом: «включены» без уровня отправляет reasoning_effort=low (без ключа гибридные модели считают, что рассуждений нет); «выключены» = reasoning_effort=none
REASONING_MODE=on
# Профиль API
# как именно передавать рассуждения: каждый профиль отправляет только свои ключи (незнакомый ключ строгий сервер считает ошибкой запроса); «все ключи сразу» — только для серверов, которые молча игнорируют чужие
THINKING_PROFILE=all
# Уровень рассуждения
# пусто — не передаётся (кроме режима «включены» у openai-профиля); понимают openai, openrouter и «все ключи сразу»
REASONING_EFFORT=high
# Бюджет рассуждения, ТОКЕНЫ
# 0 — не отправлять; понимают anthropic (thinking.budget_tokens) и dashscope (thinking_budget)
THINKING_BUDGET=0
# Свои поля тела (JSON)
# JSON-объект ключей, которых не знает ни один профиль (свой сервер); уходят в тело запроса после ключей профиля, то есть перекрывают их; битый JSON запрос не ломает — поле игнорируется с предупреждением в лог
LLM_EXTRA_BODY_JSON=

# ── Выбор провайдера (llm_provider) ──
# Приоритет провайдеров
# список идентификаторов провайдеров через запятую (tag из списка endpoint'ов модели, в нижнем регистре): запрос уйдёт первому из списка, кто обслуживает модель; пусто — ключ не отправляется вовсе
PROVIDER_ORDER=
# Только эти провайдеры
# белый список: провайдеры вне его не используются; если ни один из списка не обслуживает модель — ошибка 404, allow_fallbacks на это не влияет
PROVIDER_ONLY=
# Исключить провайдеров
# чёрный список: эти провайдеры не используются; если исключены все провайдеры модели — ошибка 404
PROVIDER_IGNORE=
# Запасные провайдеры
# относится только к приоритету: выключено — если ни одного провайдера из списка у модели нет, запрос завершится ошибкой 404 вместо чужого провайдера; на белый и чёрный списки флаг не влияет
PROVIDER_ALLOW_FALLBACKS=1
# Страна серверов провайдера
# двухбуквенный код (например ru): запрос обработают только провайдеры с серверами из этой страны; единственный фильтр, который соблюдается и в резервных попытках
PROVIDER_COUNTRY=

# ── Веб-сервер: сеть и доступ (server_net) ──
# Адрес прослушивания
# 0.0.0.0 — вся локальная сеть, тогда включайте аутентификацию
WEB_HOST=127.0.0.1
# Порт
WEB_PORT=8756
# Требовать токен
WEB_AUTH=0
# Токен
# пусто — файл .web_secret
# секрет: в UI показывается маской
WEB_TOKEN=

# ── Веб-сервер: данные и задачи (server_run) ──
# Лимит загрузки, МБ
WEB_MAX_UPLOAD_MB=512
# Максимум параллельных задач
WEB_JOBS_LIMIT=3
# Папка проектов
# пусто — <репо>/projects
WEB_PROJECTS_DIR=
# Проверить обновления при запуске
# выключено — обновления видны только по кнопке «Проверить»
WEB_UPDATE_CHECK=1
# Перезапустить сервер после обновления
# только запуск из репозитория и копия исходников; выключено — перезапуск руками
WEB_RESTART=1

# ══ Перевод ══════════════════════════════

# ── Перевод (LLM) (pipeline) ──
# Тип работы
# 1=перевод, 2=редактура (исходник - перевод), 3=полировка (исходник - редактура), 4=полировка (исходник - перевод), 5=перевод→редактура, 6=перевод→полировка, 7=редактура→полировка, 8=полный цикл
PIPELINE_ACTION=8
# Общий промпт-файл (теги translate/redact/polish)
# один файл с тегами <translate>/<redact>/<polish>; пусто = авто (первый кандидат с тегами из prompts/); недостающий тег стадии — предупреждение + встроенный промпт
PIPELINE_PROMPT_FILE=
# Размер чанка, ТОКЕНЫ
# чанкование текста для перевода и полировки (оценка токенов) — действует в ЛЮБОМ выбранном типе работы; редактура идёт главой целиком; пусто = PIPELINE_CHUNK_SIZE из .env → 7000
PIPELINE_CHUNK_SIZE=7000
# Порог схожести терминов (0–1)
# нечёткий поиск терминов по n-граммам: доля перекрытия; точные вхождения ищутся всегда
# только страница «Настройки»
PIPELINE_NER_THRESHOLD=0.75
# Размер n-грамм поиска терминов
# окно сравнения (символы)
# только страница «Настройки»
PIPELINE_NER_NGRAM=3
# Мин. count для глоссария ({ner_block})
# термины с count ниже порога НЕ попадают в {ner_block}; 0 — фильтр выключен (все найденные)
PIPELINE_NER_MIN_COUNT=0
# Мин. count для имён ({female_names}/{male_names})
# имена с count ниже порога НЕ попадают в справочник полов; 0 — фильтр выключен
PIPELINE_NAMES_MIN_COUNT=10

# ══ Глоссарий ══════════════════════════

# ── Создание глоссария (LLM) (ner) ──
# Промпт-файл (теги prompt_pass1/prompt_pass2)
# текст промпта берётся только из своего тега: <prompt_pass1> с {chunk_text} и <prompt_pass2> с {chunk_text} и {ner_json}; файла нет или тега нет — стадия на встроенном промпте
NER_PROMPT_FILE=ner_prompt.txt
# Размер чанка, ТОКЕНЫ
NER_CHUNK_SIZE=15000
# Порог дедупликации (0–1)
NER_THRESHOLD=0.75
# N-граммы для латиницы
NER_NGRAM=3
# Двухпроходная схема
NER_TWO_PASS=1
# Поля в голосование (через запятую)
# Пусто = голосуют translation/type/pinyin; notes, context, translated_context не голосуют. Пример: notes,context
NER_KEEP_FIELDS=
# Максимальная длина "context"
# СИМВОЛЫ: context извлекается из чанка — предложение с термином, не от LLM; 0 — выключено
NER_CONTEXT_MAX_LEN=300
# Не голосующие поля: какое значение брать
# настройка действует на ВСЕ текстовые неголосующие поля записи (notes, context, translated_context): LLM присылает им разные значения из разных чанков, а выбрать надо одно. «last» — как исторически; «first» — какое встретилось впервые; «longest»/«shortest» — по длине значения
NER_NON_VOTED_MODE=longest
# Ограничение длины значения, СИМВОЛЫ
# только для режима «самое длинное»: победившее значение длиннее этого числа символов — обрезается по нему; 0 — без ограничения
NER_NON_VOTED_MAX_LEN=300
# ── Проверка глоссария (LLM) (ner_check) ──
# Промпт-файл (теги prompt_ner_check/prompt_rag)
# Теги: <prompt_ner_check> — проверка выбранных типов, <prompt_rag> — точечная RAG-проверка; комментарии вне тегов — через #; автоподхват ner_check_prompt.txt
NER_CHECK_PROMPT_FILE=ner_check_prompt.txt
# RAG: бюджет на термин, ТОКЕНЫ
# На ОДИН термин: промпт + фрагменты ≤ бюджету (оценка токенов); каждый термин — отдельный LLM-запрос (параллельно, «Потоков (1–16)»); фрагменты — равномерно по книге (FTS5), влезают в остаток бюджета после промпта
NER_CHECK_RAG_BUDGET=16000
# RAG: чанк FTS5-индекса, ТОКЕНЫ
# Размер чанка, на которые режется книга для FTS5-поиска (оценка токенов): мельче — точнее привязка фрагмента к месту, крупнее — шире контекст фрагмента
NER_CHECK_RAG_CHUNK_SIZE=350
# Режимы
# одновременно — весь список выбранных типов разом (батчи по бюджету); по отдельности — каждый тип отдельно; rag — точечная проверка списка терминов по FTS5-фрагментам книги
NER_CHECK_PASSES=whole
# Бюджет запроса, ТОКЕНЫ
# каждый батч — один LLM-запрос; бюджет — потолок записей батча (промпт не входит); батчей может быть несколько
NER_CHECK_REQUEST_BUDGET=65536
# Порог count
NER_CHECK_COUNT_THRESHOLD=0
# Не проверять зафиксированные
# замок на термине: зафиксированная запись не уходит на проверку LLM и не правится патчами (см. вкладку «Глоссарий»); снято — зафиксированные проверяются как раньше, но правки по-прежнему применяются только к незафиксированным
NER_CHECK_SKIP_LOCKED=1
# Повторных запросов при отсутствии правок (0 = нет)
# 0 = нет; ответ, где правок нет (пустой JSON-массив [] или ответ без записей), не ошибка, а повод спросить ещё раз: батч или RAG-термин повторяется до N раз, последний ответ берётся как есть. Осторожно: повторы умножаются на число батчей и терминов — книга в 600 глав при 5 повторах стоит до 6× запросов
NER_CHECK_RETRY_EMPTY=0
# RAG: список терминов
# Каждый термин с новой строки; тип/перевод подтягиваются из ner.json; нужен режим «rag»
NER_CHECK_RAG_TERMS=
# RAG: тип исходного файла
# Из какого файла главы собирается текст книги для FTS5-поиска (сборка в память, файл не пишется)
NER_CHECK_RAG_SOURCE_TYPE=

# ══ Проверки ════════════════════════════

# Тип файлов глав
# Пары задаются проверяемым типом: он сравнивается с каждой стадией ниже и с оригиналом (chapter). polished — polished↔redacted, redacted↔translated, polished↔chapter; redacted — redacted↔translated, redacted↔chapter; translated — translated↔chapter; нет промежуточной стадии — её пара пропускается, остальные проверяются
TRANSLATE_CHECK_CHECK_TYPE=polished
# Слова-исключения (через запятую)
# Совпадения regexp-проверок, совпадающие с этими словами целиком, в отчёт не попадают (например «Linux», если латиница в тексте допустима); пусто = ничего не исключается
TRANSLATE_CHECK_EXCLUDE_WORDS=
# Допуск соотношения размеров: пары со стадиями, % (0 = нет)
# Пары со стадиями (polished↔redacted, redacted↔translated) сходятся почти точно: текст перевода отходит от предыдущей стадии на доли процента. Глава помечается, если отношение объёма вышло за среднее по книге × (1 ± Д%), где среднее — медиана отношений (устойчива к битым главам, пока их меньше половины базы). 0 — пары со стадиями выключены
TRANSLATE_CHECK_TOLERANCE_STAGES=5
# Допуск соотношения размеров: стадия/оригинал, % (0 = нет)
# Пары с оригиналом (chapter) расходятся на десятки процентов: объём русского текста не равен объёму исходника, и у каждой книги своё среднее отношение. Допуск шире пар со стадиями намеренно — узкий заваливал бы нормальные главы. 0 — пары с оригиналом выключены
TRANSLATE_CHECK_TOLERANCE_ORIGINAL=20
# Regexp-проверки (по одной на строку)
# Каждая строка — чистый стандартный regexp (Python re, MULTILINE): всё найденное — ошибка, проверяются ВСЕ строки включая заголовок главы; ^/$ — начало/конец СТРОКИ; регистр — inline-флагом (?i); комментариев и кастомных флагов нет («#» — литерал). Внутри значения литерал «\n» — это граница строки, поэтому перенос внутри самого паттерна пишется только как «\x0a» (или [\x0a]): иначе правило разрезает пополам. Предзаполнен набор против остатков чужого текста: лишние заголовки «Глава N» (lookbehind (?<=[\x0a]) пропускает заголовок в первой строке файла), иероглифы CJK + хирагана/катакана + хангыль (+ кавычки 【】「」『』), латиница (в т.ч. полноширинная — ловит и вкрапление в кириллическое слово: «sделать»), остальные азбуки (греческий, армянский, еврейский, арабский, индийские, тайский, грузинский, эфиопский, кхмерский), чужие кириллические раскладки — весь блок «Кириллица» кроме русских А-Я и Ё: українські і, ї, є, ґ, бел. ў, сербские ј, љ, њ, ђ, ћ, македонские ѕ, џ, ќ, ѓ, старославянские ѣ, ѵ), «первая строка не заголовок» (negative lookahead \A(?!…)). Русская азбука не проверяется — она и есть текст перевода. Пусто = без проверок; TRANSLATE_CHECK_REGEXP_CHECKS в .env — одной строкой, переносы как «\n»
TRANSLATE_CHECK_REGEXP_CHECKS=(?<=[\x0a])\s*Глава\s+(\d+|\[Номер\])\n[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\U00020000-\U0002ebef\u3040-\u30ff\u3130-\u318f\uac00-\ud7af【】「」『』]+\n[a-zA-Z\uff21-\uff3a\uff41-\uff5a]+\n[\u0370-\u03ff\u0530-\u10ff\u1200-\u13af\u1780-\u17ff\u1f00-\u1fff\u2d00-\u2d2f]+\n[\u0400\u0402-\u040F\u0450\u0452-\u045F\u0460-\u04FF]+\n\A(?!\s*Глава\s+(\d+|\[Номер\])).+
# Минимальный размер файла (БАЙТЫ)
# Файл меньше этого размера — ошибка «слишком мал»; пусто = встроенный дефолт 3072 Б
TRANSLATE_CHECK_MIN_FILE_SIZE=3072
# Проверять последовательность глав
# Первое число в первой непустой строке должно быть ровно на 1 больше предыдущей главы (N+1); выключено — проверка пропускается
TRANSLATE_CHECK_SEQUENCE_CHECK=1
# Проверять, что глава завершается символом конца предложения
# Оборванный ответ модели виден по хвосту
# Глава обязана оканчиваться знаком конца предложения — точкой, многоточием, вопросительным/восклицательным знаком, закрывающей кавычкой или скобкой. Учитываются знаки ВСЕХ письменностей (латинские .!?, CJK 。, арабский ؟, данды индийских языков, тибетские шады и прочие), поэтому проверка не зависит от языка перевода. Ловит обрыв ответа модели: сервер присылает finish_reason=stop, файл создан и непуст, а текст обрывается посередине фразы на букве. Выключено — проверка пропускается
TRANSLATE_CHECK_END_CHECK=1

# ── Проверка перевода (LLM) (translate_check_llm) ──
# Тип файлов глав
TRANSLATE_CHECK_LLM_TYPE=polished
# Сверять с оригиналом — Пары «оригинал → перевод» в одном запросе
# к каждой главе подмешивается её chapter.txt: в запрос уходят блоки «[ОРИГИНАЛ]» и «[ПЕРЕВОД]» одной пары, и правки берутся только из перевода. Так ловятся ошибки, которых в русском тексте не видно: потерянный абзац, перепутанный смысл, инверсия отрицания. Нет оригинала у главы — она проверяется как раньше; выключено — проверка только русского текста
TRANSLATE_CHECK_LLM_USE_SOURCE=1
# Глав в запросе (ГЛАВЫ) — 0 = сколько влезет в бюджет
# сколько глав (с их оригиналами) уходит в один запрос; части одной сверхбольшой главы считаются за одну главу. 0 — пакет собирается по бюджету, как раньше. Больше глав в запросе — меньше запросов, но длиннее ответ модели
TRANSLATE_CHECK_LLM_CHAPTERS_PER_REQUEST=1
# Бюджет запроса, ТОКЕНЫ
# предел пакета: главы одного запроса (+ запас 200 токенов на промпт, оценка), при «Глав в запросе» = 0 — так пакет и собирается. Глава, пара которой больше бюджета, в проверку не идёт вовсе (резать её нельзя: на стыке частей проверка видела бы пропуск текста) — такая глава пишется в лог ошибкой, поднимите бюджет
TRANSLATE_CHECK_LLM_REQUEST_BUDGET=65000
# Промпт-файл (тег prompt_translate_check, {batch_text})
# текст промпта берётся только из тега <prompt_translate_check>, батч глав вставляется в {batch_text}; файла нет или тега нет — стадия на встроенном промпте
TRANSLATE_CHECK_LLM_PROMPT_FILE=translate_check_prompt.txt
# Повторных запросов при отсутствии правок (0 = нет)
# 0 = нет; ответ без правок — не ошибка: пакет глав переспрашивается до N раз, последний ответ берётся как есть
TRANSLATE_CHECK_LLM_RETRY_EMPTY=0

# ══ Книга и файлы ══════════════════

# ── Разбор исходника на главы (epub) ──
# Исходник
# epub или txt из source/ (список фильтруется режимом разбивки: toc принимает только epub); если в source/ лежит epub, он подставляется сам; свои файлы — через вкладку «Файлы»
EPUB_INPUT=
# Режим разбивки
# toc — только epub, по структуре (TOC/spine/h1-h2); regex/chunk — epub ИЛИ txt (epub перегоняется в текст); zip не принимается
EPUB_MODE=toc
# Паттерны разбивки (regexp, по одному на строку)
# ТОЛЬКО режим regexp. Строка считается маркером, если НАЧИНАЕТСЯ с любого паттерна; вся строка становится заголовком главы; чистый стандартный regexp — без комментариев и флагов; пример: «Глава \d+»; EPUB_SPLIT_PATTERNS в .env — в .env одной строкой, переносы строк как «\n»; перенос внутри паттерна пишется «\x0a», иначе правило разрезается пополам
EPUB_SPLIT_PATTERNS=
# Размер чанка, ТОКЕНЫ
# ТОЛЬКО режим «по чанкам»; оценка токенов
EPUB_CHUNK_SIZE=7000
# Маска названия глав
# названия чанков в режиме «по чанкам»; при включённом «Переопределить названия» — названия ВСЕХ глав; {num} — номер; пример: «Часть {num}» → 00000_1_Часть_1…
EPUB_CHUNK_MASK=Chapter {num}
# Переопределить названия глав маской
# все заголовки глав заменяются на «Маска названия глав» ({num} — номер). Удобно после разбивки по TOC/паттернам: «Chapter 1», «Chapter 2»…
EPUB_RENAME_CHAPTERS=0
# Длина названия каталога, СИМВОЛЫ
# имя папки обрезается; первая строка файла — полный заголовок
EPUB_TITLE_LIMIT=50
# Смещение нумерации (первый номер)
# 875 → первая папка 000_875_… (нули добивают ширину 6)
EPUB_NUM_OFFSET=1
# Тип выходного файла
# какой файл создаётся в папке главы (канон артефактов стадий)
EPUB_OUTPUT_TYPE=chapter
# Предварительная очистка текста глав
# перед разбивкой пустые строки внутри глав убираются — каждый абзац своей строкой; пустая строка остаётся только после первой строки файла (между заголовком и телом главы). Пробелы и табуляция в начале строк убираются всегда и без галки; без галки пустые строки между абзацами остаются как в исходнике
EPUB_CLEAN_TEXT=1
# Очистить папки глав перед записью
# Удалить старые каталоги глав (00000_1_…, 00000_2_…) в chapters/ перед записью. Рекомендуется при повторном разборе — иначе старые главы останутся рядом с новыми и могут попасть в конвейер
EPUB_CLEAN_OUTPUT=1

# ── Компиляция TXT/EPUB/FB2 (compile) ──
# Режим
# TXT (Rulate) — заголовки «# [Название :|: N]» для загрузки на rulate; TXT — обычный txt без rulate-форматирования
COMPILE_MODE=txt
# Тип файлов глав
COMPILE_SOURCE_TYPE=polished
# Глав в части
# указано (>0) — диапазон разбивается на части по столько глав (файл на каждую часть), для любого режима; пусто/0 = без разбивки
COMPILE_CHUNK_SIZE=
# Обложка
# единая обложка для EPUB и FB2; пусто = без обложки; по умолчанию автоподхват cover.jpg/jpeg/png/webp из source/; варианты обложек загружаются через «Файлы»
COMPILE_COVER=
# Метаданные (YAML)
# пусто = source/metadata.yaml; по умолчанию автоподхват metadata.yaml из source/; кнопка «Редактировать» — правка выбранного файла прямо в запуске; другой yaml/yml из source/ выбирается вручную (несколько наборов метаданных)
COMPILE_EPUB_META=metadata.yaml
# Файл страницы поддержки
# страница поддержки для EPUB/FB2; пусто = без страницы; по умолчанию автоподхват donate.txt из source/; кнопка «Редактировать» — правка выбранного файла прямо в запуске; новый файл загружается через «Файлы» (source/) или «Загрузить» при пустом выборе
COMPILE_DONATE_FILE=

# ── Создание Wiki (LLM) (wiki) ──
# Источник текста
# txt — готовый скомпилированный файл; «собрать из глав» — склейка chapters/* в память (как в Создании глоссария)
WIKI_SOURCE=chapters
# Входной txt новеллы (перевод)
# нужен при источнике «Готовый txt»
WIKI_FILE=
# Тип файлов
# тип один на вход и на выход: при «Собрать из глав» читаются файлы этого типа и вики-глава пишется файлом этого же типа; при «Готовый txt» — только куда положить вики-главу; chapter.txt не пишется (это исходник): с этим типом вики-глава ложится в polished.txt
WIKI_TYPE=polished
# Выходной файл
WIKI_OUTPUT=wiki.md
# Сохранить как главу
# вместо файла — дополнительная последняя глава chapters/00000_{N+1}_Wiki_Новеллы/ с одним файлом того же типа, что выбран выше; название «Wiki Новеллы» простым текстом
WIKI_AS_CHAPTER=0
# Формат
# rulate-html: заголовки — <span style=font-size>, списки <ul>, разделители <hr />
WIKI_FORMAT=md
# Оглавление
# обычный режим; Rulate — всегда без оглавления
WIKI_TOC=1
# Якоря-ссылки в оглавлении
# обычный режим; ссылки [термин](#якорь) на статью
WIKI_TOC_LINKS=1
# Промпт (тег prompt_wiki_article: {translation}, {relations_label})
# текст статьи берётся только из тега <prompt_wiki_article>; служебные JSON-теги (<wiki_markers>, <wiki_default_markers>, <wiki_type_names_ru>, <wiki_relations_labels>, <wiki_skip_relations>, <wiki_type_order>) необязательны: без них значение встроенное
WIKI_PROMPT_FILE=wiki_prompt.txt
# Макс. терминов
WIKI_TOP=80
# Мин. частота термина
WIKI_MIN_COUNT=2
# Бюджет запроса, ТОКЕНЫ
# потолок user-запроса статьи (данные термина + связи + фрагменты, оценка); 0 = без ограничения; превышение — фрагменты обрезаются от хвоста
WIKI_REQUEST_BUDGET=0
# Фрагментов контекста на термин
WIKI_CONTEXT_CHUNKS=64
# NEAR-дистанция, ТОКЕНЫ
WIKI_NEAR_DISTANCE=64
# Размер чанка FTS5, ТОКЕНЫ
WIKI_CHUNK_SIZE=1000
# Пары типов для связей
WIKI_CO_OCCURRENCE_PAIRS=Person:Person,Person:Organisation,Person:Artifact
# Связей на термин
WIKI_CO_OCCURRENCE_TOP=7

# ── Массовые замены (batch_replace) ──
# Regexp-замены (по одной на строку)
# Формат: паттерн -> замена (чистый стандартный regexp, Python re, MULTILINE: «^»/«$» — начало/конец СТРОКИ). Пустая правая часть — УДАЛЕНИЕ: «<div>.*?</div> ->». Пробелы в паттерне значимы; регистр и прочие режимы — стандартными inline-флагами ((?i)…); комментариев и кастомных флагов нет («#» — литерал в паттерне). Примеры: «Глава \d+ -> Глава №\g<0>», «(?i)бессмертный -> Бессмертный», «\s+ -> » (сжать пробелы), «^  ->» (отступ строки), «^(第\d+章.*)\x0a(?=\1$) ->» (строка-дубликат заголовка главы). BATCH_REPLACE_REPLACEMENTS в .env — в .env одной строкой, переносы строк как «\n»; перенос внутри паттерна пишется «\x0a», иначе правило разрезается пополам
BATCH_REPLACE_REPLACEMENTS=
# Тип файлов глав
BATCH_REPLACE_TYPE=polished
# ── История (контрольные точки) (history) ──
# Точка при применении правок
# локальный git проекта: перед применением правок проверки (глоссарий, перевод) автоматически создаётся контрольная точка состояния до правок; смотреть и создавать точки — вкладка «История» проекта
HISTORY_ON_APPLY=1
# Точка после успешного запуска
# локальный git проекта: после завершения запуска стадии без ошибок создаётся точка; частые запуски — много точек, включайте осознанно
HISTORY_ON_RUN=0
# ══ UI-предпочтения ════════════════════════════════════════════════
# Внешний вид (тема интерфейса, тема и кегль редакторов, кегль
# предпросмотра, авто-обновление) в .env НЕ хранится: это состояние
# браузера (localStorage). Переключатель темы — 🌙/☀ в шапке.
