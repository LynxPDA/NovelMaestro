# ══ Сервер LLM (единая схема HOST/API_KEY/MODEL) ══
# Единственный адрес API-сервера, ключ и общая модель. Скрипты и web
# читают эти ключи (приоритет: CLI > .env > встроенный дефолт).
# Правило: один скрипт — один набор «сервер + ключ + модель»;
# своя модель скрипта не задана — берётся общая MODEL.
# Пусто = сервер не задан (скрипт попросит --host или впишите свой).
HOST=
API_KEY=
MODEL=

# ══ Серверы по скриптам (необязательно) ══
# Каждый скрипт может использовать свой сервер, ключ и модель; не
# заданы — берутся общие HOST/API_KEY/MODEL. Схема «один скрипт —
# один набор сервер+ключ+модель»: <СКРИПТ>_HOST / <СКРИПТ>_API_KEY /
# <СКРИПТ>_MODEL. Конвейер (web/pipeline.py) — ЕДИНАЯ модель:
# PIPELINE_MODEL → MODEL (отдельных моделей под translate/redact/polish
# больше нет). Раскомментируйте нужный ключ и впишите своё значение
# (комментарий «# свой сервер …» — это пояснение, а не значение).
# Свой сервер для cli/ner.py:
# NER_HOST=
# NER_API_KEY=
# NER_MODEL=
# Свой сервер для cli/ner_check.py:
# NER_CHECK_HOST=
# NER_CHECK_API_KEY=
# NER_CHECK_MODEL=
# Свой сервер для cli/translate_check_llm.py:
# TRANSLATE_CHECK_LLM_HOST=
# TRANSLATE_CHECK_LLM_API_KEY=
# TRANSLATE_CHECK_LLM_MODEL=
# Свой сервер для cli/wiki.py:
# WIKI_HOST=
# WIKI_API_KEY=
# WIKI_MODEL=
# Свой сервер для web-конвейера:
# PIPELINE_HOST=
# PIPELINE_API_KEY=
# PIPELINE_MODEL=

# ══ Web-интерфейс (ТОЛЬКО системный корневой .env; приоритет: CLI > окружение > .env) ══
# WEB_* читает только web/main.py и web/api.py из СИСТЕМНОГО корневого .env.
# В проектный pdir/.env они не копируются и там не применяются —
# не раскомментируй их в .env книги.
# Адрес прослушивания (127.0.0.1 — только этот компьютер;
# 0.0.0.0 — вся LAN, тогда включите WEB_AUTH):
# WEB_HOST=127.0.0.1
# Порт сервера (занят → берётся следующий свободный):
# WEB_PORT=8756
# 1 — требовать токен (локальный доступ: 0):
# WEB_AUTH=0
# Токен при WEB_AUTH=1 (иначе .web_secret):
# WEB_TOKEN=
# Лимит загрузки файлов, МБ:
# WEB_MAX_UPLOAD_MB=512
# Максимум параллельных задач:
# WEB_JOBS_LIMIT=2
# Папка проектов (по умолчанию <репо>/projects; читают run.py и
# web/main.py: CLI > окружение > .env):
# WEB_PROJECTS_DIR=

# ══ Опциональные дефолты (приоритет: CLI > .env > встроенный дефолт) ══
# Символы (translate/polish):
# CHUNK_SIZE=7000
# Символы:
# NER_CHUNK_SIZE=10000
# NER_THRESHOLD=0.75
# MIN_LEN_RATIO_TRANSLATE=0.5
# MIN_LEN_RATIO_REDACT=0.9
# Сек, соединение:
# TIMEOUT=300
# Сек, стрим:
# STREAM_TIMEOUT=900
# MAX_RETRIES=3

# ══ Дефолты web-конвейера (web/pipeline.py; приоритет: CLI > .env > код) ══
# Сек, один LLM-запрос внутри стадии:
# PIPELINE_TIMEOUT=300
# Сек, простой стрима:
# PIPELINE_STREAM_TIMEOUT=300
# Ретраи LLM-запроса:
# PIPELINE_MAX_RETRIES=3
# Размер чанка, СИМВОЛЫ:
# PIPELINE_CHUNK_SIZE=7000
# Порог дедупликации NER:
# PIPELINE_NER_THRESHOLD=0.75
# N-граммы для латиницы:
# PIPELINE_NER_NGRAM=3
# Параллельных глав (1–16):
# PIPELINE_JOBS=4

# ══ Короткая справка ══
# Сервер: HOST/API_KEY/MODEL. Серверы по скриптам: <СКРИПТ>_HOST/
# <СКРИПТ>_API_KEY/<СКРИПТ>_MODEL (NER/NER_CHECK/TRANSLATE_CHECK_LLM/
# WIKI/PIPELINE). Сервер web: WEB_* (только системный корневой .env).
# Ключ API в задачах web уходит в окружение LLM_API_KEY, а не в argv
# (AUDIT P1); в проектный pdir/.env не пишется.

# ══ UI-предпочтения ══
# ВСЕ настройки интерфейса — localStorage браузера, НЕ .env (12-factor):
# тема интерфейса и редакторов, кегль редакторов и предпросмотра,
# авто-обновление, режим/подсветка вкладки «Редактор», «Простой/Экспертный»
# в Запусках. Вкладка «Настройки» меняет их и хранит в браузере;
# WEB_UI_THEME/WEB_EDITOR_THEME/WEB_EDITOR_FONT_SIZE удалены.
# В .env — только серверная конфигурация (LLM, модели, WEB_*).

# ══ Настройки запусков (web) ══
# Поля формы стадии в «Запусках» предзаполняются по слоям (канон
# «окружение > файл»): os.environ (docker compose environment) →
# системный корневой .env → pdir/.env (по ключам; пустые значения
# проектного файла не затеняют глобальные; HOST/API_KEY/MODEL из
# compose environment доходят до формы даже при существующем pdir/.env).
# При каждом запуске настройки сохраняются в pdir/.env (создаётся
# копия системного .env без секретов, затем обновляются ключи
# <STAGE>_<FIELD>: NER_CHUNK_SIZE, TRANSLATE_CHECK_EXCLUDE_WORDS;
# host → <STAGE>_HOST → HOST, api_key → <STAGE>_API_KEY → API_KEY,
# model → <STAGE>_MODEL → MODEL). LLM-подключение (host/model/api_key)
# пишется только при ОТЛИЧИИ от глобального эффективного значения
# (совпадение снимает локальный оверрайд — смена сервера в compose
# или системном .env доезжает до всех проектов). Секреты (api_key)
# в префилл из окружения/системного .env не отдаются — только из
# pdir/.env. Системные настройки WEB_* в проект не копируются.
# Слова-исключения translate_check.py:
# TRANSLATE_CHECK_EXCLUDE_WORDS=VIP,MVP,【,】,NPC
# Многострочные regexp-поля (textarea) в .env — ОДНОЙ строкой, переносы
# строк как литерал «\n». Пусто = встроенный дефолт ниже.
# Полный дефолт (все CJK-иероглифы + латиница; лишние заголовки
# «Глава N» — в дефолтном наборе, первое совпадение — заголовок главы):
# TRANSLATE_CHECK_REGEXP_CHECKS=[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\U00020000-\U0002ebef【】「」『』]+\n[a-zA-Z]+\n^\s*Глава\s+\d+
# Паттерны разбивки глав:
# EPUB_SPLIT_PATTERNS=
# Правила «паттерн -> замена»:
# BATCH_REPLACE_REPLACEMENTS=
# RAG (ner_check): сохранять review-файл каждые N терминов (0 = только в конце):
# NER_CHECK_SAVE_INTERVAL=0

# ══ Дефолты формы «2 · Проверка перевода» (translate_check) ══
# Поля предзаполняются из системного .env; пусто = поле пустое (в
# CLI-скрипте — встроенный fallback). Docker: docker-compose.yml
# переопределяет эти переменные своими (env в compose-файле).
# «Выбранная Стадия/Предыдущая Стадия»:
# TRANSLATE_CHECK_NEIGHBOR=1.0±0.05
# «Выбранная Стадия/Оригинал»:
# TRANSLATE_CHECK_ORIGINAL=2.1±0.5
# Минимальный размер файла (БАЙТЫ; пусто = 3072):
# TRANSLATE_CHECK_MIN_FILE_SIZE=3072
# Заголовок главы (regexp первой непустой строки; пусто = «Глава N»
# без учёта регистра):
# TRANSLATE_CHECK_HEADER_REGEXP=
# Проверка последовательности глав (1 = вкл, 0 = выкл):
# TRANSLATE_CHECK_SEQUENCE_CHECK=1
# Дефолтные regexp-проверки (см. блок «Настройки запусков»):
# TRANSLATE_CHECK_REGEXP_CHECKS=
