# ══ Сервер LLM (единая схема HOST/API_KEY/MODEL) ══
# Единственный адрес API-сервера, ключ и общая модель. Скрипты и web
# читают эти ключи (приоритет: CLI > .env > встроенный дефолт).
# Правило: один скрипт — один набор «сервер + ключ + модель»;
# своя модель скрипта не задана — берётся общая MODEL.
HOST=                       # пусто — сервер не задан; укажите свой
API_KEY=
MODEL=

# ══ Серверы по скриптам (необязательно) ══
# Каждый скрипт может использовать свой сервер, ключ и модель; не
# заданы — берутся общие HOST/API_KEY/MODEL. Схема «один скрипт —
# один набор сервер+ключ+модель»: <СКРИПТ>_HOST / <СКРИПТ>_API_KEY /
# <СКРИПТ>_MODEL. Конвейер (web/pipeline.py) — ЕДИНАЯ модель:
# PIPELINE_MODEL → MODEL (отдельных моделей под translate/redact/polish
# больше нет).
# NER_HOST=                     # свой сервер для cli/ner.py
# NER_API_KEY=
# NER_MODEL=
# NER_CHECK_HOST=               # свой сервер для cli/ner_check.py
# NER_CHECK_API_KEY=
# NER_CHECK_MODEL=
# TRANSLATE_CHECK_LLM_HOST=     # свой сервер для cli/translate_check_llm.py
# TRANSLATE_CHECK_LLM_API_KEY=
# TRANSLATE_CHECK_LLM_MODEL=
# WIKI_HOST=                    # свой сервер для cli/wiki.py
# WIKI_API_KEY=
# WIKI_MODEL=
# PIPELINE_HOST=                # свой сервер для web-конвейера
# PIPELINE_API_KEY=
# PIPELINE_MODEL=

# ══ Web-интерфейс (ТОЛЬКО системный корневой .env; приоритет: CLI > окружение > .env) ══
# WEB_* читает только web/main.py и web/api.py из СИСТЕМНОГО корневого .env.
# В проектный pdir/.env они не копируются и там не применяются —
# не раскомментируй их в .env книги.
# WEB_HOST=127.0.0.1           # адрес прослушивания (127.0.0.1 — только этот
#                              #   компьютер; 0.0.0.0 — вся LAN, тогда включите WEB_AUTH)
# WEB_PORT=8756                 # порт сервера (занят → берётся следующий свободный)
# WEB_AUTH=0                    # 1 — требовать токен (локальный доступ: 0)
# WEB_TOKEN=                    # токен при WEB_AUTH=1 (иначе .web_secret)
# WEB_MAX_UPLOAD_MB=512         # лимит загрузки файлов, МБ
# WEB_JOBS_LIMIT=2              # максимум параллельных задач
# WEB_PROJECTS_DIR=             # папка проектов (по умолчанию <репо>/projects;
#                              #   читают run.py и web/main.py: CLI > окружение > .env)

# ══ Опциональные дефолты (приоритет: CLI > .env > встроенный дефолт) ══
# CHUNK_SIZE=7000            # символы (translate/polish)
# NER_CHUNK_SIZE=10000       # символы
# NER_THRESHOLD=0.75
# MIN_LEN_RATIO_TRANSLATE=0.5
# MIN_LEN_RATIO_REDACT=0.9
# TIMEOUT=300                # сек, соединение
# STREAM_TIMEOUT=900         # сек, стрим
# MAX_RETRIES=3

# ══ Дефолты web-конвейера (web/pipeline.py; приоритет: CLI > .env > код) ══
# PIPELINE_TIMEOUT=300           # сек, один LLM-запрос внутри стадии
# PIPELINE_STREAM_TIMEOUT=300    # сек, простой стрима
# PIPELINE_MAX_RETRIES=3         # ретраи LLM-запроса
# PIPELINE_CHUNK_SIZE=7000       # размер чанка, СИМВОЛЫ
# PIPELINE_NER_THRESHOLD=0.75    # порог дедупликации NER
# PIPELINE_NER_NGRAM=3           # N-граммы для латиницы
# PIPELINE_JOBS=4                # параллельных глав (1–16)

# ══ Короткая справка ══
# Сервер: HOST/API_KEY/MODEL. Серверы по скриптам: <СКРИПТ>_HOST/
# <СКРИПТ>_API_KEY/<СКРИПТ>_MODEL (NER/NER_CHECK/TRANSLATE_CHECK_LLM/
# WIKI/PIPELINE). Сервер web: WEB_* (только системный корневой .env).
# Ключ API в задачах web уходит в окружение LLM_API_KEY, а не в argv
# (AUDIT P1); в проектный pdir/.env не пишется.

# ══ UI-предпочтения ══
# ВСЕ настройки интерфейса — localStorage браузера, НЕ .env (12-factor):
# тема интерфейса и редакторов, кегль редакторов и предпросмотра,
# авто-обновление, режим/подсветка вкладки «Редактор», «Простой/Экспертный»
# в Запусках. Вкладка «Настройки» меняет их и хранит в браузере;
# WEB_UI_THEME/WEB_EDITOR_THEME/WEB_EDITOR_FONT_SIZE удалены.
# В .env — только серверная конфигурация (LLM, модели, WEB_*).

# ══ Настройки запусков (web) ══
# Поля формы стадии в «Запусках» предзаполняются из .env и при каждом
# запуске сохраняются обратно: системный корневой .env → копия в папку
# проекта (pdir/.env), если её нет, затем обновляются ключи
# <STAGE>_<FIELD> (напр. NER_CHUNK_SIZE, TRANSLATE_CHECK_EXCLUDE_WORDS;
# host → <STAGE>_HOST → HOST, api_key → <STAGE>_API_KEY → API_KEY,
# model → <STAGE>_MODEL → MODEL).
# Проектный pdir/.env приоритетнее системного. Ключ из формы пишется
# как <СТАДИЯ>_API_KEY (fallback — API_KEY); системный API_KEY в
# копию не переносится. Системные настройки WEB_* в проект не
# копируются.
# TRANSLATE_CHECK_EXCLUDE_WORDS=VIP,MVP,【,】,NPC   # слова-исключения
#                                                   # translate_check.py
# Многострочные regexp-поля (textarea) в .env — ОДНОЙ строкой, переносы
# строк как литерал «\n» (например «[一-鿿]+\n[a-zA-Z]+»):
# TRANSLATE_CHECK_REGEXP_CHECKS=  # regexp-проверки текста (пусто = дефолт)
# EPUB_SPLIT_PATTERNS=            # паттерны разбивки глав
# BATCH_REPLACE_REPLACEMENTS=     # правила «паттерн -> замена»

# ══ Дефолты формы «2 · Проверка перевода» (translate_check) ══
# Поля предзаполняются из системного .env; пусто = поле пустое (в
# CLI-скрипте — встроенный fallback). Docker: docker-compose.yml
# переопределяет эти переменные своими (env в compose-файле).
# TRANSLATE_CHECK_NEIGHBOR=1.0±0.05        # «Выбранная Стадия/Предыдущая Стадия»
# TRANSLATE_CHECK_ORIGINAL=2.1±0.5         # «Выбранная Стадия/Оригинал»
# TRANSLATE_CHECK_REGEXP_CHECKS=\n        # дефолтные regexp-проверки,
#                                          #   «[CHINESE]\n[a-zA-Z]+» — см. README
